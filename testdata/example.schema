attributeTypes ( 1.3.6.1.4.1.56521.389.2.31.3.7 NAME 'monitorConnectionLastActive' DESC 'Time at which a connection was most recently active' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE NO-USER-MODIFICATION USAGE directoryOperation X-ORIGIN 'Jesse Coretta' X-DO-NOT-ADVERTISE 'TRUE' )
attributeTypes ( 1.3.6.1.4.1.56521.389.2.31.3.8 NAME 'monitorConnectionLocalAddr' DESC 'The address and port of the DSA to which a connection was established' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE NO-USER-MODIFICATION USAGE dSAOperation X-ORIGIN 'Jesse Coretta' X-DO-NOT-ADVERTISE 'TRUE' )
